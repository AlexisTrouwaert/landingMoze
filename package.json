{
  "name": "landing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:prod": "ng build --configuration production",
    "archive:prod": "npm run build:prod && mkdir -p build/prod && (cd dist/landing && tar -czvf ../../build/prod/landing-PROD-$(date +%Y%m%d%H%M%S).tar.gz .)",
    "archive:prod-win": "npm run build:prod && powershell -Command \"mkdir -p build/prod -ErrorAction SilentlyContinue; cd dist/landing; tar -czvf ../../build/prod/landing-PROD-$(Get-Date -Format 'yyyyMMddHHmmss').tar.gz .\"",
    "test": "ng test",
    "serve:ssr:landing": "node dist/landing/server/server.mjs",
    "remotes:setup": "node scripts/sync-remotes.mjs setup",
    "remotes:status": "node scripts/sync-remotes.mjs status",
    "push:both": "node scripts/sync-remotes.mjs push"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/platform-server": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/ssr": "^21.2.18",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.17",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3"
  }
}